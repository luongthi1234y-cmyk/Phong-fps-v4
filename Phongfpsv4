-- Hàm tạo nút Toggle chuẩn
local function CreateToggle(name, yPos, callback)
    local ToggleBtn = Instance.new("TextButton")
    ToggleBtn.Size = UDim2.new(1, -20, 0, 30)
    ToggleBtn.Position = UDim2.new(0, 10, 0, yPos)
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(150, 40, 40)
    ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    ToggleBtn.Text = name .. " [TẮT]"
    ToggleBtn.Font = Enum.Font.GothamSemibold
    ToggleBtn.TextSize = 13
    ToggleBtn.Parent = MainFrame

    local isOn = false
    ToggleBtn.MouseButton1Click:Connect(function()
        isOn = not isOn
        ToggleBtn.BackgroundColor3 = isOn and Color3.fromRGB(40, 150, 40) or Color3.fromRGB(150, 40, 40)
        ToggleBtn.Text = name .. (isOn and " [BẬT]" or " [TẮT]")
        callback(isOn)
    end)
    return ToggleBtn
end

-- ================= 2. CHỨC NĂNG 1: NO FOG (XÓA SƯƠNG MÙ TẬN GỐC) =================
local noFogLoop = nil
CreateToggle("No Fog (Nhìn Xuyên Sương Mù)", 42, function(state)
    if state then
        noFogLoop = task.spawn(function()
            while task.wait(1) do
                Lighting.FogEnd = 9e9
                Lighting.FogStart = 9e9
                for _, v in pairs(Lighting:GetChildren()) do
                    if v:IsA("Atmosphere") then
                        v.Density = 0
                        v.Haze = 0
                    end
                end
            end
        end)
    else
        if noFogLoop then task.cancel(noFogLoop) end
        Lighting.FogEnd = 1000
    end
end)

-- ================= 3. CHỨC NĂNG 2: LỘT DA MAP (FIX LAG) =================
CreateToggle("Lột Da Map & Tắt Hạt", 80, function(state)
    if not state then return end
    task.spawn(function()
        if Workspace.Terrain then
            Workspace.Terrain.WaterWaveSize = 0
            Workspace.Terrain.WaterReflectance = 0
            Workspace.Terrain.Decoration = false
        end

        local count = 0
        for _, v in pairs(Workspace:GetDescendants()) do
            if v:IsA("BasePart") then
                v.Material = Enum.Material.SmoothPlastic
                v.CastShadow = false
                v.Reflectance = 0
            elseif v:IsA("Decal") or v:IsA("Texture") then
                if v.Name ~= "Face" then v.Transparency = 1 end
            elseif v:IsA("MeshPart") then
                v.TextureID = ""
            elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Sparkles") or v:IsA("Smoke") then
                v.Enabled = false
            end
            
            count = count + 1
            if count % 400 == 0 then task.wait() end
        end
    end)
end)

