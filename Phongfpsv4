-- ================= 6. CHỨC NĂNG 5: CỤT ĐẦU GIỮ TÓC + FULL KORBLOX R15/R6 =================
local isSkinActive = false

local function ApplyRichKidSkin(char)
    if not char then return end
    local alpha = isSkinActive and 1 or 0

    -- 1. Cụt đầu nhưng GIỮ NGUYÊN tóc/mũ (Chỉ tàng hình Head và Face)
    local head = char:FindFirstChild("Head")
    if head then
        head.Transparency = alpha
        if head:FindFirstChild("face") then head.face.Transparency = alpha end
        if head:FindFirstChild("Mesh") then head.Mesh.Transparency = alpha end
    end

    -- 2. Full Korblox R15 (Xóa sạch cả 3 khúc: Đùi trên, Bắp chân, Bàn chân)
    local r15Parts = {"RightUpperLeg", "RightLowerLeg", "RightFoot"}
    for _, partName in ipairs(r15Parts) do
        local part = char:FindFirstChild(partName)
        if part then part.Transparency = alpha end
    end

    -- 3. Korblox cho R6
    local r6Leg = char:FindFirstChild("Right Leg")
    if r6Leg then r6Leg.Transparency = alpha end
end

